# 게임 프로젝트 레포 절대 경로 (호스트마다 다름)
# 현재 작업 브랜치에 upstream이 설정돼 있어야 하며, 회의 보고에는 push된 커밋만 포함된다.
GAME_PROJECT_PATH=

# Discord — PM이 봇 생성 후 토큰 공유. USER_ID는 본인 것
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# 회의 포럼 채널 ID (포럼 채널이어야 함, 텍스트 채널 아님)
# 이 포럼에 다음 3개 태그가 정확히 이 이름으로 있어야 한다:
#   진행 — prepare_meeting이 만든 회의 스레드에 자동 부착
#   완료 — finish_meeting이 회의 종료 시 부착
#   정리 — finish_meeting이 새로 만든 요약 스레드에 부착
# 태그명을 바꾸고 싶으면 아래 DISCORD_TAG_* 로 오버라이드
DISCORD_SCRUM_CHANNEL_ID=
DISCORD_TAG_IN_PROGRESS=진행
DISCORD_TAG_COMPLETED=완료
DISCORD_TAG_SUMMARY=정리

# Notion — PM/팀장만
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_LOCK_DB_ID=

# Jira — PM/팀장만
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_HOST=
JIRA_PROJECT_KEY=

# finish_meeting 실행 권한 있는 Discord user ID 목록 (콤마 구분)
ALLOWED_USERS=
