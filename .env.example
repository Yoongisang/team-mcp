# 게임 프로젝트 레포 절대 경로 (호스트마다 다름)
# 회의 보고는 아래 ref 이후 현재 브랜치 upstream에 push된 개인 커밋을 포함한다.
GAME_PROJECT_PATH=
GIT_REPORT_REF=origin/develop
# Discord 표시명과 Git author가 다르면 JSON으로 매핑한다.
# 예: {"Discord닉네임":"GitAuthorName","다른닉네임":"git@example.com"}
GIT_AUTHOR_MAP={}

# Discord — Bot 토큰은 비밀 관리 수단으로 전달. USER_ID는 Channels/식별용 선택 항목
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# 회의 포럼 채널 ID (포럼 채널이어야 함, 텍스트 채널 아님)
# 이 포럼에 다음 3개 태그가 정확히 이 이름으로 있어야 한다:
#   진행 — prepare_meeting이 만든 회의 스레드에 자동 부착
#   완료 — finish_meeting이 회의 종료 시 부착
#   정리 — finish_meeting이 새로 만든 요약 스레드에 부착
# 태그명을 바꾸고 싶으면 아래 DISCORD_TAG_* 로 오버라이드
DISCORD_SCRUM_CHANNEL_ID=
DISCORD_TAG_IN_PROGRESS=진행
DISCORD_TAG_COMPLETED=완료
DISCORD_TAG_SUMMARY=정리

# Notion — PM/팀장만
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_LOCK_DB_ID=

# Jira — PM/팀장만
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_HOST=
JIRA_PROJECT_KEY=
JIRA_TASK_TYPE=Task

# finish_meeting/apply_meeting_to_backlog 실행 권한이 있는 Discord user ID 목록
# 콤마로 구분하며 username이 아닌 snowflake ID를 사용한다.
ALLOWED_USERS=
